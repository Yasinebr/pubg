{
  "compilerOptions": {
    /* خروجی مدرن برای Node 22 */
    "target": "ES2020",

    /* پشتیبانی از کتابخانه‌های مرورگر و Node */
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    /* فعال کردن ویژگی‌های مهم */
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,

    /* 🔹 این بخش‌ها مهم‌ترین تغییرات هستند */
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,

    /* خروجی در پوشه dist برای فایل‌های سرور */
    "outDir": "dist",

    /* React */
    "jsx": "react-jsx"
  },

  /* فایل‌هایی که باید کامپایل شوند */
  "include": [
    "src",
    "server.ts",
    "db_setup.ts"
  ],

  /* فایل‌هایی که نباید کامپایل شوند (مثلاً node_modules) */
  "exclude": [
    "node_modules"
  ]
}
